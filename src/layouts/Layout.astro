---
import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/playfair-display/latin-500.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Pfad der Seite ohne Sprachpräfix, '' für die Startseite. */
  slug: string;
  title: string;
  description: string;
}

const { lang, slug, title, description } = Astro.props;
const content = getContent(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14120f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script is:inline>
      if ('IntersectionObserver' in window) document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="font-sans antialiased">
    <a href="#main" class="skip-link rounded-full bg-accent px-4 py-2 text-sm font-medium text-base-950">
      {content.a11y.skipToContent}
    </a>
    <Header lang={lang} slug={slug} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Beim Aufruf mit Sprungmarke (z. B. vom Impressum aus /de/#werkstatt)
      // springt nicht jeder Browser zuverlässig selbst zur Sektion.
      if (location.hash) {
        document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView({ behavior: 'instant' });
      }

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -60px 0px' },
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
