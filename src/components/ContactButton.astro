---
import { isPlaceholder } from '../content/site-config';

interface Props {
  icon: any;
  label: string;
  value: string;
  href: string | null;
  placeholderNote: string;
  external?: boolean;
  large?: boolean;
}

const { icon: Icon, label, value, href, placeholderNote, external = false, large = false } = Astro.props;
const placeholder = isPlaceholder(value) || href === null;

const sizeClasses = large ? 'px-6 py-4 text-base' : 'px-5 py-3 text-sm';
---

{
  placeholder ? (
    <span
      class={`inline-flex items-center gap-2.5 rounded-full border border-dashed border-base-600 text-ink-muted ${sizeClasses}`}
      aria-disabled="true"
    >
      <Icon class="h-4 w-4 shrink-0" aria-hidden="true" />
      <span>{label}</span>
      <span class="text-xs text-base-400">({placeholderNote})</span>
    </span>
  ) : (
    <a
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
      class={`inline-flex items-center gap-2.5 rounded-full border border-base-600 text-ink transition-colors hover:border-accent hover:text-accent ${sizeClasses}`}
    >
      <Icon class="h-4 w-4 shrink-0" aria-hidden="true" />
      <span>{label}</span>
    </a>
  )
}
