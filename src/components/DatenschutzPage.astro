---
import Layout from '../layouts/Layout.astro';
import { getContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const t = content.datenschutz;
---

<Layout lang={lang} slug="datenschutz" title={t.meta.title} description={t.meta.description}>
  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
    <h1 class="font-serif text-4xl text-ink sm:text-5xl">{t.heading}</h1>
    <p class="mt-6 text-lg text-ink-muted">{t.intro}</p>

    <div class="mt-10 space-y-10 text-ink-muted">
      {
        t.sections.map((section) => (
          <div>
            <h2 class="font-serif text-xl text-ink">{section.heading}</h2>
            <p class="mt-3">{section.text}</p>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
