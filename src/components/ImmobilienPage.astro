---
import Layout from '../layouts/Layout.astro';
import PageHeader from './PageHeader.astro';
import { getContent, type Lang } from '../i18n/utils';
import { images } from '../content/images';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const t = content.immobilien;
---

<Layout lang={lang} slug="immobilien" title={t.meta.title} description={t.meta.description}>
  <PageHeader heading={t.intro.heading} text={t.intro.text} />

  <section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.items.map((item) => {
          const image = images[`immo_${item.key}` as keyof typeof images];
          return (
            <article class="fade-in-up">
              <div class="aspect-[4/3] overflow-hidden rounded-sm bg-base-800">
                <img
                  src={image.src}
                  alt={item.imageAlt}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
              <h2 class="mt-5 font-serif text-xl text-ink">{item.title}</h2>
              <p class="mt-2 text-sm text-ink-muted">{item.text}</p>
            </article>
          );
        })
      }
    </div>
  </section>
</Layout>
