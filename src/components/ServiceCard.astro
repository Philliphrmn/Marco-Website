---
interface Props {
  icon: any;
  title: string;
  text?: string;
  isPlaceholder?: boolean;
  placeholderNote?: string;
}

const { icon: Icon, title, text, isPlaceholder = false, placeholderNote } = Astro.props;
---

<div
  class={`fade-in-up rounded-sm border p-6 ${
    isPlaceholder ? 'border-dashed border-base-600' : 'border-base-800 bg-base-900/40'
  }`}
>
  <Icon class={`h-6 w-6 ${isPlaceholder ? 'text-base-400' : 'text-accent'}`} aria-hidden="true" />
  <h3 class={`mt-4 font-serif text-lg ${isPlaceholder ? 'text-ink-muted' : 'text-ink'}`}>{title}</h3>
  {text && <p class="mt-2 text-sm text-ink-muted">{text}</p>}
  {isPlaceholder && placeholderNote && <p class="mt-2 text-xs text-base-400">({placeholderNote})</p>}
</div>
