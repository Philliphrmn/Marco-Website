---
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import FieldSection from './FieldSection.astro';
import Contact from './Contact.astro';
import { getContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
---

<Layout lang={lang} slug="" title={content.meta.title} description={content.meta.description}>
  <Hero lang={lang} />
  <About lang={lang} />
  {content.sections.map((section, i) => <FieldSection {...section} index={i + 1} />)}
  <Contact lang={lang} />
</Layout>
