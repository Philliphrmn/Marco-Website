---
import Layout from '../layouts/Layout.astro';
import BusinessCard from './BusinessCard.astro';
import About from './About.astro';
import Fields from './Fields.astro';
import Contact from './Contact.astro';
import { getContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { meta } = getContent(lang);
---

<Layout lang={lang} slug="" title={meta.title} description={meta.description}>
  <BusinessCard lang={lang} />
  <About lang={lang} />
  <Fields lang={lang} />
  <Contact lang={lang} />
</Layout>
