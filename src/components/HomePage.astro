---
import Layout from '../layouts/Layout.astro';
import { getContent, path, type Lang } from '../i18n/utils';
import { images } from '../content/images';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const t = content.home;
---

<Layout lang={lang} slug="" title={content.meta.homeTitle} description={content.meta.homeDescription}>
  <!-- Hero -->
  <section class="relative flex min-h-[100svh] items-end overflow-hidden bg-base-950">
    <img
      src={images.hero.src}
      alt={t.hero.imageAlt}
      width={images.hero.width}
      height={images.hero.height}
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-base-950 via-base-950/55 to-base-950/25" aria-hidden="true">
    </div>

    <div class="relative mx-auto w-full max-w-6xl px-5 pb-16 pt-40 sm:px-8 sm:pb-24">
      <h1 class="font-serif text-4xl uppercase leading-tight tracking-[0.1em] text-ink sm:text-5xl md:text-6xl">
        {t.hero.name}
      </h1>
      <p class="mt-5 max-w-xl text-base text-ink-muted sm:text-lg">
        {t.hero.tagline}
      </p>
    </div>
  </section>

  <!-- About -->
  <section class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
    <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">
      <div class="fade-in-up order-2 md:order-1">
        <h2 class="font-serif text-3xl text-ink sm:text-4xl">{t.about.heading}</h2>
        <div class="mt-6 space-y-5 text-ink-muted">
          {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="fade-in-up order-1 md:order-2">
        <div class="aspect-[4/5] overflow-hidden rounded-sm bg-base-800">
          <img
            src={images.portrait.src}
            alt={t.about.imageAlt}
            width={images.portrait.width}
            height={images.portrait.height}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Tätigkeitsfelder -->
  <section class="border-t border-base-800 bg-base-900">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <h2 class="sr-only">{t.tiles.heading}</h2>
      <div class="grid gap-8 sm:grid-cols-2">
        {
          t.tiles.items.map((tile, index) => {
            const image = images[`tile_${tile.key}` as keyof typeof images];
            return (
              <a
                href={path(lang, tile.href)}
                class="fade-in-up group block"
                style={`transition-delay: ${Math.min(index, 3) * 90}ms`}
              >
                <div class="aspect-[4/3] overflow-hidden rounded-sm bg-base-800">
                  <img
                    src={image.src}
                    alt={tile.imageAlt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  />
                </div>
                <h3 class="mt-5 font-serif text-xl text-ink transition-colors group-hover:text-accent sm:text-2xl">
                  {tile.title}
                </h3>
                <p class="mt-2 max-w-md text-sm text-ink-muted">{tile.text}</p>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>
