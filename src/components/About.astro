---
import { Image } from 'astro:assets';
import { getContent, type Lang } from '../i18n/utils';
import { images } from '../content/images';

interface Props {
  lang: Lang;
}

const t = getContent(Astro.props.lang).about;
---

<section id="ueber-mich" class="bg-white">
  <div class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-20 sm:px-8 md:grid-cols-[2fr_3fr] md:gap-16 md:py-28">
    <Image
      src={images.portrait}
      alt={t.imageAlt}
      widths={[400, 640, 900]}
      sizes="(min-width: 768px) 36vw, 100vw"
      class="reveal aspect-[4/5] w-full max-w-xs rounded-md object-cover shadow-card"
    />
    <div class="reveal">
      <h2 class="font-serif text-4xl font-medium sm:text-5xl">{t.heading}</h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink-soft">
        {t.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>
