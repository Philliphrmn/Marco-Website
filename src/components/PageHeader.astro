---
interface Props {
  heading: string;
  text: string;
}

const { heading, text } = Astro.props;
---

<section class="mx-auto max-w-6xl px-5 pt-16 pb-4 sm:px-8 sm:pt-24 sm:pb-8">
  <h1 class="fade-in-up font-serif text-4xl text-ink sm:text-5xl">{heading}</h1>
  <p class="fade-in-up mt-5 max-w-2xl text-lg text-ink-muted">{text}</p>
</section>
