---
import Layout from '../layouts/Layout.astro';
import { getContent, type Lang } from '../i18n/utils';
import { isPlaceholder, siteConfig } from '../content/site-config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const t = content.impressum;

const phoneDisplay = isPlaceholder(siteConfig.telefon)
  ? `(${content.footer.placeholderNote})`
  : siteConfig.telefon;
const emailDisplay = isPlaceholder(siteConfig.email) ? `(${content.footer.placeholderNote})` : siteConfig.email;
---

<Layout lang={lang} slug="impressum" title={t.meta.title} description={t.meta.description}>
  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
    <h1 class="font-serif text-4xl text-ink sm:text-5xl">{t.heading}</h1>

    <div class="mt-10 space-y-10 text-ink-muted">
      <div>
        <h2 class="font-serif text-xl text-ink">{t.angabenHeading}</h2>
        <p class="mt-3">
          {t.name}
          <br />
          {
            t.addressLines.map((line) => (
              <>
                {line}
                <br />
              </>
            ))
          }
        </p>
        <p class="mt-3">
          {t.phoneLabel}: {phoneDisplay}
          <br />
          {t.emailLabel}: {emailDisplay}
        </p>
      </div>

      <div>
        <h2 class="font-serif text-xl text-ink">{t.haftungInhalteHeading}</h2>
        <p class="mt-3">{t.haftungInhalteText}</p>
      </div>

      <div>
        <h2 class="font-serif text-xl text-ink">{t.haftungLinksHeading}</h2>
        <p class="mt-3">{t.haftungLinksText}</p>
      </div>
    </div>
  </section>
</Layout>
