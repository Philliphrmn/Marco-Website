---
import { Menu, X } from '@lucide/astro';
import { getContent, path, type Lang } from '../i18n/utils';
import { siteConfig } from '../content/site-config';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Monogram from './Monogram.astro';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const content = getContent(lang);
const isHome = slug === '';

// Auf der Startseite reine Sprungmarken, auf Unterseiten zurück zur Startseite.
const anchor = (id: string) => (isHome ? `#${id}` : `${path(lang)}#${id}`);
const links = [
  { id: 'ueber-mich', label: content.nav.about },
  ...content.sections.map((s) => ({ id: s.id, label: s.label })),
  { id: 'kontakt', label: content.nav.contact },
];
---

<!--
  Auf der Startseite ist der Header ausgeblendet, solange die Visitenkarte
  im Bild ist (data-hidden, nur mit JavaScript), und gleitet beim Scrollen herein.
-->
<header
  id="site-header"
  data-hidden={isHome ? '' : undefined}
  class="fixed inset-x-0 top-0 z-40 border-b border-line/70 bg-paper/90 backdrop-blur transition-transform duration-300 in-[.js]:data-hidden:-translate-y-full"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
    <a
      href={isHome ? '#top' : path(lang)}
      class="flex items-center gap-3 font-serif text-lg text-ink transition-colors hover:text-ink-soft"
    >
      <Monogram class="h-8 w-8" />
      {siteConfig.name}
    </a>

    <nav aria-label={content.a11y.mainNav} class="hidden items-center gap-7 lg:flex">
      {
        links.map((link) => (
          <a
            href={anchor(link.id)}
            data-nav-link={link.id}
            class="text-sm text-ink-soft decoration-1 underline-offset-8 transition-colors hover:text-ink data-active:text-ink data-active:underline"
          >
            {link.label}
          </a>
        ))
      }
      <LanguageSwitcher lang={lang} slug={slug} label={content.a11y.languageSwitch} />
    </nav>

    <div class="flex items-center gap-3 lg:hidden">
      <LanguageSwitcher lang={lang} slug={slug} label={content.a11y.languageSwitch} />
      <button
        id="menu-open"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-10 w-10 items-center justify-center text-ink"
      >
        <Menu class="h-6 w-6" aria-hidden="true" />
        <span class="sr-only">{content.a11y.openMenu}</span>
      </button>
    </div>
  </div>
</header>

<!--
  Bewusst außerhalb von <header>: backdrop-blur macht den Header zum
  Containing Block für position:fixed - das Overlay wäre sonst nur so hoch
  wie der Header.
-->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label={content.a11y.mainNav}
  class="fixed inset-0 z-50 hidden flex-col bg-paper lg:hidden"
>
  <div class="flex h-16 items-center justify-end px-5 sm:px-8">
    <button id="menu-close" type="button" class="inline-flex h-10 w-10 items-center justify-center text-ink">
      <X class="h-6 w-6" aria-hidden="true" />
      <span class="sr-only">{content.a11y.closeMenu}</span>
    </button>
  </div>
  <nav aria-label={content.a11y.mainNav} class="flex flex-1 flex-col items-center justify-center gap-7 pb-16">
    {
      links.map((link) => (
        <a href={anchor(link.id)} class="font-serif text-3xl text-ink transition-colors hover:text-ink-soft">
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<script>
  const menu = document.getElementById('mobile-menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const closeBtn = document.getElementById('menu-close')!;

  function setMenu(open: boolean) {
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  openBtn.addEventListener('click', () => {
    setMenu(true);
    closeBtn.focus();
  });
  closeBtn.addEventListener('click', () => {
    setMenu(false);
    openBtn.focus();
  });
  menu.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenu(false);
      openBtn.focus();
    }
  });
  // Ein Klick auf einen Menüpunkt schließt das Menü, der Browser springt dann zur Sektion.
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // Startseite: Header erst zeigen, wenn die Visitenkarte größtenteils verlassen ist.
  const header = document.getElementById('site-header')!;
  const hero = document.getElementById('top');
  if (hero && header.hasAttribute('data-hidden') && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => {
        const hidden = entry.intersectionRatio >= 0.5;
        header.toggleAttribute('data-hidden', hidden);
        header.inert = hidden;
      },
      { threshold: 0.5 },
    ).observe(hero);
  }

  // Aktive Sektion in der Desktop-Navigation hervorheben.
  const navLinks = document.querySelectorAll<HTMLElement>('[data-nav-link]');
  // Der Hero (#top) wird mitbeobachtet, damit oben keine Sektion markiert ist.
  const sections = ['top', ...[...navLinks].map((link) => link.dataset.navLink!)]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          navLinks.forEach((link) => {
            link.toggleAttribute('data-active', link.dataset.navLink === entry.target.id);
          });
        }
      },
      // Eine Sektion gilt als aktiv, sobald sie die Bildschirmmitte erreicht.
      { rootMargin: '-50% 0px -50% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
