---
import { CircleDashed, Sparkles, Snowflake, Trees, Wind } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import PageHeader from './PageHeader.astro';
import ServiceCard from './ServiceCard.astro';
import { getContent, type Lang } from '../i18n/utils';
import { images } from '../content/images';
import { isPlaceholder, siteConfig } from '../content/site-config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const t = content.facility;

const fmName = isPlaceholder(siteConfig.fmFirmenname) ? content.meta.siteName : siteConfig.fmFirmenname;
const introText = t.intro.text.replace('{{FM}}', fmName);

const icons: Record<string, any> = {
  winterdienst: Snowflake,
  gruenflaechen: Trees,
  kehrmaschine: Wind,
  gebaeudereinigung: Sparkles,
  weitere: CircleDashed,
};

/**
 * Winterdienst steht Oktober bis März an erster Stelle, sonst
 * Grünflächenpflege - der Rest behält seine Reihenfolge.
 */
function sortByMonth(services: typeof t.services.items, month: number) {
  const isWinterSeason = month >= 9 || month <= 2;
  const priorityKey = isWinterSeason ? 'winterdienst' : 'gruenflaechen';
  return [...services].sort((a, b) => {
    if (a.key === priorityKey) return -1;
    if (b.key === priorityKey) return 1;
    return 0;
  });
}

const currentMonth = new Date().getMonth();
const sortedServices = sortByMonth(t.services.items, currentMonth);
---

<Layout lang={lang} slug="facility" title={t.meta.title} description={t.meta.description}>
  <PageHeader heading={t.intro.heading} text={introText} />

  <section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <h2 class="sr-only">{t.services.heading}</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        sortedServices.map((service) => (
          <ServiceCard
            icon={icons[service.key]}
            title={service.title}
            text={service.text}
            isPlaceholder={'isPlaceholder' in service && service.isPlaceholder}
            placeholderNote={content.footer.placeholderNote}
          />
        ))
      }
    </div>
  </section>

  <section class="border-t border-base-800 bg-base-900">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="fade-in-up font-serif text-2xl text-ink sm:text-3xl">{t.gallery.heading}</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          t.gallery.items.map((item) => {
            const image = images[item.key as keyof typeof images];
            return (
              <div class="fade-in-up aspect-[3/2] overflow-hidden rounded-sm bg-base-800">
                <img
                  src={image.src}
                  alt={item.alt}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>
