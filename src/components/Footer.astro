---
import { getContent, path, type Lang } from '../i18n/utils';
import { siteConfig } from '../content/site-config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-base-800">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-8 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p>&copy; {year} {siteConfig.name}</p>
    <nav aria-label={content.a11y.legalNav} class="flex gap-6">
      <a href={path(lang, 'impressum')} class="transition-colors hover:text-ink">{content.footer.impressum}</a>
      <a href={path(lang, 'datenschutz')} class="transition-colors hover:text-ink">{content.footer.datenschutz}</a>
    </nav>
  </div>
</footer>
