---
import Layout from '../layouts/Layout.astro';
import PageHeader from './PageHeader.astro';
import { getContent, type Lang } from '../i18n/utils';
import { images } from '../content/images';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
const t = content.automobile;
---

<Layout lang={lang} slug="automobile" title={t.meta.title} description={t.meta.description}>
  <PageHeader heading={t.intro.heading} text={t.intro.text} />

  <section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <h2 class="fade-in-up font-serif text-2xl text-ink sm:text-3xl">{t.collection.heading}</h2>
    <p class="fade-in-up mt-3 max-w-2xl text-ink-muted">{t.collection.text}</p>

    <div class="fade-in-up mt-8 aspect-[8/5] max-w-xl overflow-hidden rounded-sm bg-base-800">
      <img
        src={images.automobile_sammlung.src}
        alt={t.collection.coverAlt}
        width={images.automobile_sammlung.width}
        height={images.automobile_sammlung.height}
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
  </section>

  <section class="border-t border-base-800 bg-base-900">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="fade-in-up font-serif text-2xl text-ink sm:text-3xl">{t.restoration.heading}</h2>
      <p class="fade-in-up mt-3 max-w-2xl text-ink-muted">{t.restoration.text}</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          t.restoration.items.map((item) => {
            const image = images[item.key as keyof typeof images];
            return (
              <div class="fade-in-up aspect-[4/3] overflow-hidden rounded-sm bg-base-800">
                <img
                  src={image.src}
                  alt={item.alt}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <h2 class="fade-in-up font-serif text-2xl text-ink sm:text-3xl">{t.trade.heading}</h2>
    <p class="fade-in-up mt-3 max-w-2xl text-ink-muted">{t.trade.text}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        t.trade.items.map((item) => {
          const image = images[item.key as keyof typeof images];
          return (
            <div class="fade-in-up aspect-[4/3] overflow-hidden rounded-sm bg-base-800">
              <img
                src={image.src}
                alt={item.alt}
                width={image.width}
                height={image.height}
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 text-center sm:px-8 sm:py-20">
    <p class="fade-in-up mx-auto max-w-xl text-lg text-ink-muted">{t.outro}</p>
  </section>
</Layout>
