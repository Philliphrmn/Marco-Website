---
import { Mail, MessageCircle, Phone, UserPlus } from '@lucide/astro';
import { getContent, type Lang } from '../i18n/utils';
import { mailHref, siteConfig, telHref, whatsappHref } from '../content/site-config';
import LinkButton from './LinkButton.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';

interface Props {
  lang: Lang;
}

const t = getContent(Astro.props.lang).contact;
const { adresse } = siteConfig;
---

<section id="kontakt" class="border-t border-base-800 bg-base-900">
  <div class="reveal mx-auto max-w-3xl px-5 py-24 text-center sm:px-8 md:py-32">
    <h2 class="font-serif text-4xl text-ink sm:text-5xl">{t.heading}</h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">{t.text}</p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <LinkButton href={telHref(siteConfig.telefon)} variant="primary">
        <Phone class="h-4 w-4" aria-hidden="true" />
        {t.call}
      </LinkButton>
      <LinkButton href={whatsappHref(siteConfig.whatsapp)} external>
        <MessageCircle class="h-4 w-4" aria-hidden="true" />
        {t.whatsapp}
      </LinkButton>
      <LinkButton href={mailHref(siteConfig.email)}>
        <Mail class="h-4 w-4" aria-hidden="true" />
        {t.email}
      </LinkButton>
      <LinkButton href={siteConfig.linkedinUrl} external>
        <LinkedinIcon class="h-4 w-4" />
        {t.linkedin}
      </LinkButton>
    </div>

    <a
      href="/marco-herrmann.vcf"
      download
      class="mt-8 inline-flex items-center gap-2 text-sm text-ink-muted underline-offset-4 transition-colors hover:text-accent hover:underline"
    >
      <UserPlus class="h-4 w-4" aria-hidden="true" />
      {t.saveContact}
    </a>

    <address class="mt-12 text-sm not-italic leading-relaxed text-ink-muted">
      {siteConfig.name}<br />
      {adresse.strasse}<br />
      {`${adresse.plz} ${adresse.ort}`}
    </address>
  </div>
</section>
