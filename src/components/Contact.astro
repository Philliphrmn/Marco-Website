---
import { Mail, MapPin, MessageCircle, Phone, UserPlus } from '@lucide/astro';
import { getContent, type Lang } from '../i18n/utils';
import { mailHref, mapsHref, siteConfig, telHref, whatsappHref } from '../content/site-config';
import LinkButton from './LinkButton.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';

interface Props {
  lang: Lang;
}

const t = getContent(Astro.props.lang).contact;
const { adresse } = siteConfig;
---

<section id="kontakt">
  <div class="reveal mx-auto max-w-3xl px-5 py-20 text-center sm:px-8 md:py-28">
    <h2 class="font-serif text-4xl font-medium sm:text-5xl">{t.heading}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">{t.text}</p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <LinkButton href={telHref(siteConfig.telefon)} variant="primary">
        <Phone class="h-4 w-4" aria-hidden="true" />
        {t.call}
      </LinkButton>
      <LinkButton href={whatsappHref(siteConfig.whatsapp)} external>
        <MessageCircle class="h-4 w-4" aria-hidden="true" />
        {t.whatsapp}
      </LinkButton>
      <LinkButton href={mailHref(siteConfig.email)}>
        <Mail class="h-4 w-4" aria-hidden="true" />
        {t.email}
      </LinkButton>
      <LinkButton href={siteConfig.linkedinUrl} external>
        <LinkedinIcon class="h-4 w-4" />
        {t.linkedin}
      </LinkButton>
    </div>

    <div class="mt-12 flex flex-col items-center gap-6 text-sm text-ink-soft sm:flex-row sm:justify-center sm:gap-10">
      <address class="not-italic leading-relaxed">
        {siteConfig.name}<br />
        {adresse.strasse}<br />
        {`${adresse.plz} ${adresse.ort}`}
      </address>
      <div class="flex flex-col gap-2 sm:items-start">
        <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-ink hover:underline">
          <MapPin class="h-4 w-4" aria-hidden="true" />
          {t.directions}
        </a>
        <a href="/marco-herrmann.vcf" download class="inline-flex items-center gap-2 hover:text-ink hover:underline">
          <UserPlus class="h-4 w-4" aria-hidden="true" />
          {t.saveContact}
        </a>
      </div>
    </div>
  </div>
</section>
