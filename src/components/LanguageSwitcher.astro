---
import { languages, path, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  slug: string;
  label: string;
}

const { lang, slug, label } = Astro.props;
---

<div role="group" aria-label={label} class="flex items-center text-xs tracking-[0.15em]">
  {
    languages.map((l, i) => (
      <>
        {i > 0 && <span class="text-line" aria-hidden="true">/</span>}
        <a
          href={path(l, slug)}
          hreflang={l}
          lang={l}
          aria-current={l === lang ? 'page' : undefined}
          class={`px-1.5 py-2 uppercase transition-colors ${
            l === lang ? 'text-ink underline underline-offset-4' : 'text-ink-faint hover:text-ink'
          }`}
        >
          {l}
        </a>
      </>
    ))
  }
</div>
