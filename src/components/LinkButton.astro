---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
}

const { variant = 'secondary', external = false, class: className, ...attrs } = Astro.props;

const variants = {
  primary: 'border-accent bg-accent text-base-950 hover:border-accent-dark hover:bg-accent-dark',
  secondary: 'border-base-600 text-ink hover:border-accent hover:text-accent',
};
---

<a
  {...attrs}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex items-center gap-2.5 rounded-full border px-5 py-3 text-sm font-medium transition-colors',
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
