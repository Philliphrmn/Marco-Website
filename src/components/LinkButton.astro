---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
}

const { variant = 'secondary', external = false, class: className, ...attrs } = Astro.props;

const variants = {
  primary: 'border-ink bg-ink text-paper hover:bg-ink/85',
  secondary: 'border-ink/20 text-ink hover:border-ink',
};
---

<a
  {...attrs}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex items-center gap-2.5 rounded-full border px-5 py-3 text-sm transition-colors',
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
